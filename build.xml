<project name="FlexCoverageDemo" default="test">

    <property environment="env"/>
    <property name="FLEX_HOME" value="${env.FLEX_HOME}"/>

    <property name="SRC_DIR" value="src"/>
    <property name="TEST_DIR" value="test"/>
    <property name="BUILD_DIR" value="build"/>

    <!-- Register Flex Ant Tasks -->
    <taskdef resource="flexTasks.tasks">
        <classpath>
            <pathelement location="${FLEX_HOME}/ant/lib/flexTasks.jar"/>
        </classpath>
    </taskdef>

    <target name="clean">
        <delete dir="${BUILD_DIR}"/>
    </target>

    <target name="compile">
        <mkdir dir="${BUILD_DIR}"/>
        <mxmlc
            file="${SRC_DIR}/Calculator.as"
            output="${BUILD_DIR}/Calculator.swf"
            debug="true"/>
    </target>

    <target name="test" depends="compile">
        <echo message="Flex build successful (tests placeholder)"/>
    </target>

</project>
