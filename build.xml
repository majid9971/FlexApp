<project name="FlexApp" default="compile" basedir=".">

    <property environment="env"/>
    <property name="FLEX_HOME" value="${env.FLEX_HOME}"/>

    <property name="src.dir" value="src"/>
    <property name="build.dir" value="build"/>

    <!-- Load Flex Ant tasks -->
    <taskdef
        resource="flexTasks.tasks"
        classpath="${FLEX_HOME}/ant/lib/flexTasks.jar"/>

    <target name="validate-env">
        <fail unless="FLEX_HOME">
            FLEX_HOME is not set
        </fail>
    </target>

    <target name="compile" depends="validate-env">
        <mkdir dir="${build.dir}"/>

        <mxmlc
            file="${src.dir}/Main.mxml"
            output="${build.dir}/app.swf"/>
    </target>

</project>
