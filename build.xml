<project name="FlexApp" default="test">

    <property name="FLEX_HOME" value="${env.FLEX_HOME}" />
    <property name="src.dir" value="src"/>
    <property name="test.dir" value="test"/>
    <property name="build.dir" value="build"/>
    <property name="libs.dir" value="lib/flexunit"/>

    <taskdef resource="flexTasks.tasks"
             classpath="${FLEX_HOME}/ant/lib/flexTasks.jar"/>

    <target name="compile">
        <mkdir dir="${build.dir}"/>
        <mxmlc
            source-path="${src.dir}"
            output="${build.dir}/app.swf"
            library-path="${libs.dir}"
            />
    </target>

    <target name="test" depends="compile">
        <echo message="FlexUnit tests compiled successfully"/>
    </target>

</project>
